# Cross-origin isolation everywhere: the audio engine and the test pages need
# SharedArrayBuffer (multi-threaded WebAssembly, shared audio memory).
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# The offline web app's service worker (lot 4): always asked again, so that a
# new version is found at the next launch.
/sw.js
  Cache-Control: no-cache
