{
  "name": "fabtice-desktop",
  "productName": "Fabtice",
  "version": "0.1.0",
  "description": "Fabtice, app Mac : interface et import audio depuis un lien YouTube",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\"",
    "check:ui": "node ci/check-ui.js",
    "build:ui": "npm --prefix ../app ci && npm --prefix ../app run build:desktop",
    "dist:dir": "node ci/check-ui.js && electron-builder --dir --publish never",
    "dist:mac:arm64": "node ci/check-ui.js && electron-builder --mac --arm64 --publish never -c.mac.artifactName=Fabtice-mac-apple-silicon.'${ext}' -c.dmg.artifactName=Fabtice-mac-apple-silicon.'${ext}'",
    "dist:mac:x64": "node ci/check-ui.js && electron-builder --mac --x64 --publish never -c.mac.artifactName=Fabtice-mac-intel.'${ext}' -c.dmg.artifactName=Fabtice-mac-intel.'${ext}'"
  },
  "devDependencies": {
    "electron": "43.8.9",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  },
  "build": {
    "appId": "org.fabtice.desktop",
    "productName": "Fabtice",
    "copyright": "Fabtice — GPL-3.0-or-later",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "package.json",
      "build-info.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "minimumSystemVersion": "12.0",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Fabtice",
      "writeUpdateInfo": false
    },
    "publish": null
  }
}
